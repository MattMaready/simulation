# Shell scripts and ROS files MUST keep LF line endings, even when edited on Windows,
# otherwise bash in WSL fails with "$'\r': command not found".
*.sh        text eol=lf
*.py        text eol=lf
*.xacro     text eol=lf
*.urdf      text eol=lf
*.sdf       text eol=lf
*.yaml      text eol=lf
*.rviz      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
scripts/.env* text eol=lf

# Windows-side files keep CRLF
*.ps1       text eol=crlf
*.cs        text eol=crlf
*.uproject  text eol=crlf
*.ini       text eol=crlf

# Unreal binary assets
*.uasset    binary
*.umap      binary
