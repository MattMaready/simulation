# -----------------------------------------------------------------------------
# robot_splunker local settings.
# Copy this file to scripts/.env and edit. scripts/.env is git-ignored.
# Read by: common.sh (bld.sh, up.sh, dn.sh) and bld_ue.ps1.
# Use SINGLE quotes around Windows paths so bash keeps the backslashes.
# -----------------------------------------------------------------------------

# Root of the Unreal Engine install on Windows (folder that contains Engine\).
# Leave empty to skip the Unreal build/launch steps.
UE_ROOT='C:\Program Files\Epic Games\UE_5.5'

# Optional: explicit path to UnrealEditor.exe (defaults to $UE_ROOT\Engine\Binaries\Win64\UnrealEditor.exe).
UE_EDITOR_EXE=''

# ROS 2 domain id used by every node started from up.sh (keeps this graph separate
# from other ROS 2 systems on your network).
ROS_DOMAIN_ID=42

# Port the ue_bridge WebSocket server listens on (UE connects to ws://127.0.0.1:<port>).
UE_BRIDGE_PORT=9090
