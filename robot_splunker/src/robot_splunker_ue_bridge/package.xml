<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_splunker_ue_bridge</name>
  <version>0.1.0</version>
  <description>WebSocket bridge that streams robot_splunker state (ground-truth pose, wheels, lidar, SLAM map, explorer status) to the Unreal Engine 5 visualizer, converted to Unreal coordinates.</description>
  <maintainer email="matt.maready@gmail.com">robot_splunker maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
