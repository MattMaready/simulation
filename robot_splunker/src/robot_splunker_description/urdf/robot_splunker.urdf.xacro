<?xml version="1.0"?>
<!--
  robot_splunker.urdf.xacro — top-level description of the robot_splunker
  differential-drive mobile robot.

  Structure (links ← joints):
    base_footprint                        (ground projection, root link)
      └─ base_joint (fixed) ── base_link  (wheel axle centre)
           ├─ chassis_joint (fixed)       ── chassis       box body
           ├─ left_wheel_joint  (continuous, axis +y) ── left_wheel   cylinder
           ├─ right_wheel_joint (continuous, axis +y) ── right_wheel  cylinder
           ├─ caster_joint (fixed)        ── caster_link   sphere (zero friction)
           ├─ lidar_joint (fixed)         ── lidar_link    (sensors.xacro)
           └─ imu_joint (fixed)           ── imu_link      (sensors.xacro)

  Files:
    properties.xacro            dimensions & masses
    inertial_macros.xacro       inertia tensor macros
    robot_splunker.gazebo.xacro colours, friction, Gazebo plugins & sensors
    sensors.xacro               lidar + IMU links/joints

  Expand by hand:  xacro robot_splunker.urdf.xacro > /tmp/robot.urdf && check_urdf /tmp/robot.urdf
-->
<robot name="robot_splunker" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Includes use paths relative to this file, so the xacro also expands without
       a sourced workspace (bld.sh validates it before colcon runs). The Gazebo file
       is included early because it defines the colour properties/materials used below. -->
  <xacro:include filename="properties.xacro"/>
  <xacro:include filename="inertial_macros.xacro"/>
  <xacro:include filename="robot_splunker.gazebo.xacro"/>

  <!-- ================= base_footprint / base_link ================= -->
  <!-- base_footprint has no geometry or mass; it is the frame Nav2/SLAM use. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link is a pure frame at the wheel axle centre (rotation centre). -->
  <link name="base_link"/>

  <!-- ================= Chassis ================= -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${chassis_x_offset} 0 ${chassis_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="splunker_orange"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- ================= Drive wheels ================= -->
  <!-- wheel macro
       prefix  : left | right   (link "<prefix>_wheel", joint "<prefix>_wheel_joint")
       reflect : +1 for left (+y), -1 for right (-y)
       The cylinder's own axis is z; rotating it -90° about x points the axis along +y,
       matching the joint axis, so a positive joint angle rolls the robot forward. -->
  <xacro:macro name="wheel" params="prefix reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="splunker_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" rpy="${-pi/2} 0 0"/>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ================= Front caster ================= -->
  <!-- Modelled as a FIXED sphere with (near) zero friction in robot_splunker.gazebo.xacro.
       This is the standard Gazebo approach: it supports the front of the robot and
       slides in any direction, without simulating a swivel + wheel (two extra joints
       that tend to jitter). Its bottom touches the ground: z = caster_r - wheel_r. -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="splunker_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <!-- ================= Sensors ================= -->
  <xacro:include filename="sensors.xacro"/>

</robot>
