<?xml version="1.0"?>
<!--
  inertial_macros.xacro — solid-body inertia tensors for the primitive shapes used by
  robot_splunker. Each macro emits a complete <inertial> block (mass, origin, inertia).

  Formulas (uniform density, about the centre of mass, shape's own axes):
    Box (x, y, z):         ixx = m(y²+z²)/12   iyy = m(x²+z²)/12   izz = m(x²+y²)/12
    Cylinder (r, h; axis z): ixx = iyy = m(3r²+h²)/12            izz = m r²/2
    Sphere (r):            ixx = iyy = izz = 2 m r²/5
  Off-diagonal terms are zero for these symmetric shapes.

  The optional xyz/rpy place (and rotate) the inertia frame, e.g. a wheel cylinder
  rotated so its axis points along y.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="box_inertia" params="m x y z xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y + z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x + z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x + y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r + h*h)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3*r*r + h*h)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
               iyy="${2.0*m*r*r/5.0}" iyz="0.0"
               izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

</robot>
